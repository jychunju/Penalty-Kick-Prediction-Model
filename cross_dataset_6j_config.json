{
  "seed": 42,
  "train_csv": "kicker_pose_keypoints.csv",
  "external_test_csv": "penalty_pose_keypoints.csv",
  "joint_ids": [11, 12, 13, 14, 15, 16],
  "frames": 16,
  "frame_stride": 1,
